<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Northwind Bank</title>
<style>
  :root { --text:#111827; --text2:#4b5563; --text3:#9ca3af; --text4:#d1d5db; --border:#e5e7eb; --muted:#f3f4f6; --surface:#fff; --positive:#16a34a; --danger:#dc2626; --c1:#2563eb; --c2:#dc2626; --c3:#16a34a; --c4:#7c3aed; --c5:#6b7280; }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif; background:var(--muted); color:var(--text); min-height:100vh; display:flex; align-items:flex-start; justify-content:center; padding:24px 16px; }
  .bank { width:100%; max-width:420px; }
  .view { display:none; } .view.active { display:block; animation:fadeIn .2s ease-out; }
  @keyframes fadeIn { from {opacity:0;transform:translateY(4px)} to {opacity:1;transform:none} }
  .card,.bal-card,.pane-card { background:var(--surface); border:1px solid var(--border); border-radius:12px; }
  .card,.bal-card { padding:20px; } .login-head { text-align:center; margin:48px 0 20px; }
  .login-logo { width:44px;height:44px;margin:0 auto 12px; } .bank-name {font-size:20px;font-weight:600} .bank-tag {font-size:14px;color:var(--text3);margin-top:4px}
  .field {margin-bottom:16px} .field label {display:block;font-size:14px;color:var(--text2);margin-bottom:6px}
  .field input,.field select {width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:10px;font:inherit;background:#fff;color:var(--text);outline:none}
  .field input:focus,.field select:focus {border-color:var(--text)} .field input.err {border-color:var(--danger)}
  .btn {width:100%;padding:11px 16px;border:none;border-radius:10px;cursor:pointer;font-weight:600;font-size:15px;transition:opacity .15s}
  .btn:hover {opacity:.85} .btn-primary {background:var(--text);color:#fff} .btn-ghost {background:transparent;color:var(--text);border:1px solid var(--border)}
  .form-error {display:none;align-items:center;gap:8px;font-size:13px;color:var(--danger);margin:-4px 0 12px} .form-error.show {display:flex} .form-error svg {width:16px;height:16px;flex:none}
  .demo-hint {margin-top:16px;font-size:13px;color:var(--text3);text-align:center} .demo-hint code {font-family:monospace;font-size:12px;background:var(--muted);padding:2px 6px;border-radius:6px}
  .app-head {display:flex;align-items:center;gap:12px;margin:8px 0 20px} .avatar {width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:600;flex:none}
  .who {flex:1;min-width:0}.who .nm {font-size:16px;font-weight:600}.who .ac {font-size:13px;color:var(--text3);font-variant-numeric:tabular-nums}
  .icon-btn {width:36px;height:36px;border-radius:8px;border:1px solid var(--border);background:#fff;color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center}
  .icon-btn svg,.eye-btn svg {width:18px;height:18px} .bal-card {margin-bottom:20px}
  .bal-top {display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}.bal-label {font-size:14px;color:var(--text2)}
  .eye-btn {background:none;border:none;cursor:pointer;color:var(--text3);padding:4px;display:flex}.bal-num {font-size:36px;font-weight:600;line-height:1.1;font-variant-numeric:tabular-nums}
  .tabs {display:flex;gap:4px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:4px;margin-bottom:20px}
  .tab {flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:8px 0;border:none;border-radius:6px;background:transparent;color:var(--text2);font-size:14px;font-weight:600;cursor:pointer}
  .tab svg {width:16px;height:16px}.tab.active {background:var(--text);color:#fff}
  .pane-card {padding:8px 16px 12px}.sec-title {font-size:14px;color:var(--text2);margin:12px 0 4px}
  .tx-row {display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}.tx-row:last-child {border-bottom:none}
  .tx-av {width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;flex:none}
  .tx-info {flex:1;min-width:0}.tx-name {font-size:14px;font-weight:600}.tx-meta {font-size:12px;color:var(--text3);margin-top:2px}
  .tx-amt {font-size:14px;font-weight:600;font-variant-numeric:tabular-nums}.tx-amt.in {color:var(--positive)}.tx-empty {font-size:14px;color:var(--text3);padding:16px 0}
  .avail {display:flex;justify-content:space-between;font-size:13px;color:var(--text3);margin:-6px 0 16px;font-variant-numeric:tabular-nums}
  .amount-wrap {position:relative}.amount-wrap .cur {position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text3);font-size:15px}
  .amount-wrap input {padding-left:30px;font-size:20px;font-variant-numeric:tabular-nums}
  .review {border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:16px}.review-row {display:flex;justify-content:space-between;font-size:14px;padding:4px 0}
  .review-row .k {color:var(--text3)}.review-row .v {font-weight:600;font-variant-numeric:tabular-nums}
  .success {text-align:center;padding:24px 0 12px}.success .ck {width:48px;height:48px;margin:0 auto 12px;color:var(--positive)}
  .success .t1 {font-size:17px;font-weight:600}.success .t2 {font-size:14px;color:var(--text3);margin:6px 0 20px}
  .foot {margin-top:20px;text-align:center;font-size:12px;color:var(--text4)}
</style>
</head>
<body>
<div class="bank">
  <div class="view active" id="v-login">
    <div class="login-head">
      <svg class="login-logo" viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M17 3.8H7C5.78497 3.8 4.8 4.78497 4.8 6V15.7647C4.8 16.574 5.24438 17.318 5.95698 17.7017L10.957 20.394C11.6081 20.7446 12.3919 20.7446 13.043 20.394L18.043 17.7017C18.7556 17.318 19.2 16.574 19.2 15.7647V6C19.2 4.78497 18.215 3.8 17 3.8ZM7 2C4.79086 2 3 3.79086 3 6V15.7647C3 17.2362 3.80796 18.5889 5.1036 19.2866L10.1036 21.9789C11.2875 22.6164 12.7125 22.6164 13.8964 21.9789L18.8964 19.2866C20.192 18.5889 21 17.2362 21 15.7647V6C21 3.79086 19.2091 2 17 2H7Z" fill="currentColor"/><path fill-rule="evenodd" clip-rule="evenodd" d="M16.7248 8.63051C17.0763 8.98198 17.0763 9.55183 16.7248 9.9033L11.7627 14.8654C11.4113 15.2169 10.8414 15.2169 10.4899 14.8654L7.81839 12.1939C7.46692 11.8424 7.46691 11.2726 7.81839 10.9211C8.16986 10.5696 8.7397 10.5696 9.09118 10.9211L11.1263 12.9562L15.4521 8.63051C15.8035 8.27904 16.3734 8.27904 16.7248 8.63051Z" fill="currentColor"/></svg>
      <div class="bank-name">Northwind Bank</div><div class="bank-tag">Sign in to your account</div>
    </div>
    <div class="card">
      <div class="field"><label for="lg-user">Email address</label><input id="lg-user" type="email" autocomplete="username" placeholder="name@example.com" required></div>
      <div class="field"><label for="lg-pin">Password</label><input id="lg-pin" type="password" autocomplete="current-password" placeholder="Enter your password" required></div>
      <div class="form-error" id="lg-err"><span aria-hidden="true">⚠</span><span id="lg-err-msg">Incorrect email address or password.</span></div>
      <button class="btn btn-primary" id="lg-btn">Sign in</button>
      <button class="btn btn-ghost" id="show-signup" style="margin-top:10px">Create your account</button>
      <div id="signup-panel" style="display:none;margin-top:18px;padding-top:18px;border-top:1px solid var(--border)">
        <h2 style="font-size:17px;margin-bottom:14px">Create your account</h2>
        <div class="field"><label for="su-name">Full name</label><input id="su-name" type="text" maxlength="60" autocomplete="name" placeholder="Your full name"></div>
        <div class="field"><label for="su-email">Email address</label><input id="su-email" type="email" autocomplete="email" placeholder="you@example.com"></div>
        <div class="field"><label for="su-password">Create password</label><input id="su-password" type="password" minlength="8" autocomplete="new-password" placeholder="At least 8 characters"></div>
        <div class="form-error" id="su-err"><span aria-hidden="true">⚠</span><span id="su-err-msg"></span></div>
        <button class="btn btn-primary" id="su-btn">Create account</button>
        <button class="btn btn-ghost" id="hide-signup" style="margin-top:8px">Back to sign in</button>
      </div>
    </div>
  </div>

  <div class="view" id="v-admin">
    <div class="app-head"><div class="avatar" style="background:#fee2e2;color:#991b1b">AD</div><div class="who"><div class="nm">Administrator controls</div><div class="ac">Administrator panel</div></div><button class="icon-btn" id="admin-logout" title="Log out" aria-label="Log out">↪</button></div>
    <div class="card" style="margin-bottom:16px"><h2 style="font-size:18px;margin-bottom:8px">Transfer controls</h2><p style="font-size:13px;color:var(--text2);line-height:1.5;margin-bottom:14px">Turn transfers on or off for all customer accounts.</p><div id="admin-global-status" style="font-size:14px;font-weight:600;margin-bottom:12px">Transfers are enabled</div><button class="btn btn-primary" id="admin-toggle-transfers">Restrict all transfers</button></div>
    <div class="card"><h2 style="font-size:18px;margin-bottom:8px">Account fund controls</h2><p style="font-size:13px;color:var(--text2);line-height:1.5;margin-bottom:14px">Hold an account to block outgoing transfers from it, or release the hold.</p>
      <div style="border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:12px"><div style="font-weight:600;margin-bottom:4px">Alex Carter <span style="color:var(--text3);font-weight:400">(•••• 9012)</span></div><div id="admin-alex-status" style="font-size:13px;color:var(--text2);margin-bottom:10px">Funds available</div><button class="btn btn-ghost" id="admin-alex-toggle">Hold Alex's funds</button></div>
      <div style="border:1px solid var(--border);border-radius:10px;padding:14px"><div style="font-weight:600;margin-bottom:4px">Sam Rivera <span style="color:var(--text3);font-weight:400">(•••• 4477)</span></div><div id="admin-sam-status" style="font-size:13px;color:var(--text2);margin-bottom:10px">Funds available</div><button class="btn btn-ghost" id="admin-sam-toggle">Hold Sam's funds</button></div></div>
    <div class="card" style="margin-top:16px"><h2 style="font-size:18px;margin-bottom:8px">Add account history</h2><p style="font-size:13px;color:var(--text2);line-height:1.5;margin-bottom:14px">Manually add a transaction to a customer's activity. The entry also adjusts the displayed account balance.</p>
      <div class="field"><label for="hist-user">Customer account</label><select id="hist-user"></select></div>
      <div class="field"><label for="hist-name">Transaction description</label><input id="hist-name" type="text" maxlength="60" placeholder="e.g. Salary payment" /></div>
      <div class="field"><label for="hist-dir">Transaction type</label><select id="hist-dir"><option value="in">Money in (+)</option><option value="out">Money out (−)</option></select></div>
      <div class="field"><label for="hist-amt">Amount (USD)</label><input id="hist-amt" type="number" min="0.01" step="0.01" placeholder="0.00" /></div>
      <div class="field"><label for="hist-date">Date</label><input id="hist-date" type="date" /></div>
      <div class="field"><label for="hist-note">Note (optional)</label><input id="hist-note" type="text" maxlength="80" placeholder="Optional note" /></div>
      <div class="form-error" id="hist-err"><span aria-hidden="true">⚠</span><span id="hist-err-msg"></span></div>
      <button class="btn btn-primary" id="hist-add">Add history entry</button><div id="hist-msg" style="font-size:13px;color:var(--positive);margin-top:10px" role="status"></div>
    </div>
    <div class="foot">Prototype only. Demo data is saved in this browser on this device; it is not securely stored or shared across devices.</div>
  </div>
  <div class="view" id="v-app">
    <div class="app-head"><div class="avatar" id="me-avatar">A</div><div class="who"><div class="nm" id="me-name">—</div><div class="ac" id="me-acct">—</div></div><button class="icon-btn" id="btn-logout" title="Log out" aria-label="Log out">↪</button></div>
    <div class="bal-card"><div class="bal-top"><span class="bal-label">Total balance</span><button class="eye-btn" id="btn-eye" title="Show / hide balance" aria-label="Show or hide balance">◉</button></div><div class="bal-num" id="bal-num">$0.00</div></div>
    <div class="tabs">
      <button class="tab active" id="tab-ov">◷ Activity</button><button class="tab" id="tab-tr">⇄ Transfer</button>
    </div>
    <div class="pane-card" id="pane-ov"><h3 class="sec-title">Recent activity</h3><div id="tx-list"></div></div>
    <div class="pane-card" id="pane-tr" style="display:none">
      <div id="tr-form">
        <div class="field" style="margin-top:12px"><label for="tr-to">Recipient</label><select id="tr-to"></select></div>
        <div class="field"><label for="tr-amt">Amount</label><div class="amount-wrap"><span class="cur">$</span><input id="tr-amt" type="number" min="0" step="0.01" placeholder="0.00"></div></div>
        <div class="field"><label for="tr-note">Note <span style="color:var(--text4)">(optional)</span></label><input id="tr-note" type="text" maxlength="40" placeholder="What's it for?"></div>
        <div class="avail"><span>Available balance</span><span id="tr-avail">—</span></div>
        <div class="form-error" id="tr-err"><span aria-hidden="true">⚠</span><span id="tr-err-msg">—</span></div><button class="btn btn-primary" id="tr-next">Review transfer</button>
      </div>
      <div id="tr-confirm" style="display:none"><h3 class="sec-title">Review transfer</h3><div class="review"><div class="review-row"><span class="k">To</span><span class="v" id="cf-to">—</span></div><div class="review-row"><span class="k">Amount</span><span class="v" id="cf-amt">—</span></div><div class="review-row" id="cf-note-row" style="display:none"><span class="k">Note</span><span class="v" id="cf-note">—</span></div><div class="review-row"><span class="k">Fee</span><span class="v">$0.00</span></div></div><button class="btn btn-primary" id="cf-send" style="margin-bottom:8px">Confirm &amp; send</button><button class="btn btn-ghost" id="cf-back">Back</button></div>
      <div id="tr-done" style="display:none"><div class="success"><div class="ck" aria-hidden="true">✓</div><div class="t1">Transfer sent</div><div class="t2" id="done-msg">—</div><button class="btn btn-primary" id="done-btn">Done</button></div></div>
    </div>
    <div class="foot">Prototype account — balances and transfers are simulated; no real money moves.</div>
  </div>
</div>
<script>
(function(){
  var fmt=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'});
  var AV=['var(--c1)','var(--c4)','var(--c2)','var(--c5)','var(--c3)'];
  var DB={
    alex:{email:'alex@northwind.demo',password:'AlexDemo!29',name:'Alex Carter',acct:'•••• 9012',balance:12480.50,hidden:false,tx:[
      {name:'Payroll — Meridian Studio',amount:3450,dir:'in',date:'Oct 14'},
      {name:'Whole Foods Market',amount:-86.32,dir:'out',date:'Oct 13'},
      {name:'Sam Rivera',amount:-120,dir:'out',date:'Oct 11',note:'Dinner split'},
      {name:'City Power & Light',amount:-64.10,dir:'out',date:'Oct 8'},
      {name:'Refund — Amazon',amount:42.99,dir:'in',date:'Oct 5'}]},
    sam:{email:'sam@northwind.demo',password:'SamDemo!29',name:'Sam Rivera',acct:'•••• 4477',balance:8320.75,hidden:false,tx:[
      {name:'Payroll — Brightline Co',amount:2980,dir:'in',date:'Oct 14'},
      {name:'Alex Carter',amount:120,dir:'in',date:'Oct 11',note:'Dinner split'},
      {name:'Netflix',amount:-15.49,dir:'out',date:'Oct 9'},
      {name:'Metro Transit',amount:-40,dir:'out',date:'Oct 7'}]}
  };
  // Demo-only local persistence. This is not secure storage and is not suitable for real customer accounts.
  var STORAGE_KEY='northwind-bank-demo-state-v2';
  function saveState(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify({DB:DB,transfersRestricted:transfersRestricted,fundsHeld:fundsHeld}))}catch(e){}}
  function loadState(){try{var saved=JSON.parse(localStorage.getItem(STORAGE_KEY)||'null');if(saved&&saved.DB){DB=saved.DB;transfersRestricted=!!saved.transfersRestricted;fundsHeld=Object.assign(fundsHeld,saved.fundsHeld||{});}}catch(e){}}
  function refreshHistoryUsers(selected){var sel=$('hist-user');if(!sel)return;sel.textContent='';Object.keys(DB).forEach(function(key){var opt=document.createElement('option');opt.value=key;opt.textContent=DB[key].name+' ('+DB[key].email+')';sel.appendChild(opt)});if(selected&&DB[selected])sel.value=selected;}
  var CONTACTS=['Maya Chen','Jordan Lee','Priya Nair','Tom Becker','Whole Foods Market'];
  var me=null,pending=null;
  var transfersRestricted=false;
  var fundsHeld={alex:false,sam:false};
  function $(id){return document.getElementById(id)}
  function initials(n){return n.split(' ').map(function(w){return w[0]}).join('').slice(0,2).toUpperCase()}
  function avColor(n){var h=0;for(var i=0;i<n.length;i++)h=(h*31+n.charCodeAt(i))%997;return AV[h%AV.length]}
  function today(){var d=new Date(),m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return m[d.getMonth()]+' '+d.getDate()}
  function show(view){document.querySelectorAll('.view').forEach(function(v){v.classList.remove('active')});$(view).classList.add('active')}
  function login(){var email=$('lg-user').value.trim().toLowerCase(),password=$('lg-pin').value;$('lg-err').classList.remove('show');$('lg-pin').classList.remove('err');if(email==='admin@northwind.demo'&&password==='AdminDemo!29'){me='admin';pending=null;$('lg-user').value='';$('lg-pin').value='';renderAdmin();show('v-admin')}else{var u=Object.keys(DB).find(function(k){return DB[k].email===email&&DB[k].password===password});if(u){me=u;pending=null;$('lg-user').value='';$('lg-pin').value='';renderApp();show('v-app')}else{$('lg-err-msg').textContent='Incorrect email address or password.';$('lg-err').classList.add('show');$('lg-pin').classList.add('err')}}}
  $('lg-btn').addEventListener('click',login);$('lg-pin').addEventListener('keydown',function(e){if(e.key==='Enter')login()});$('lg-user').addEventListener('keydown',function(e){if(e.key==='Enter')$('lg-pin').focus()});
  $('show-signup').addEventListener('click',function(){$('signup-panel').style.display='';$('show-signup').style.display='none';$('lg-err').classList.remove('show')});
  $('hide-signup').addEventListener('click',function(){$('signup-panel').style.display='none';$('show-signup').style.display='';$('su-err').classList.remove('show')});
  $('su-btn').addEventListener('click',function(){var name=$('su-name').value.trim(),email=$('su-email').value.trim().toLowerCase(),password=$('su-password').value;$('su-err').classList.remove('show');function signupError(msg){$('su-err-msg').textContent=msg;$('su-err').classList.add('show')}if(name.length<2){signupError('Enter your full name.');return}if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){signupError('Enter a valid email address.');return}if(password.length<8){signupError('Use a password with at least 8 characters.');return}if(email==='admin@northwind.demo'||Object.keys(DB).some(function(k){return DB[k].email===email})){signupError('An account already exists with this email.');return}var key='user_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,7);DB[key]={email:email,password:password,name:name,acct:'•••• '+String(Math.floor(1000+Math.random()*9000)),balance:0,hidden:false,tx:[]};saveState();refreshHistoryUsers(key);$('su-name').value='';$('su-email').value='';$('su-password').value='';$('signup-panel').style.display='none';$('show-signup').style.display='';$('lg-user').value=email;$('lg-pin').value=password;login()});
  function renderApp(){var u=DB[me];$('me-name').textContent=u.name;$('me-acct').textContent='Checking '+u.acct;$('me-avatar').textContent=initials(u.name);$('me-avatar').style.background='color-mix(in srgb,'+avColor(u.name)+' 18%,transparent)';$('me-avatar').style.color=avColor(u.name);renderBalance();renderTx();$('tr-to').innerHTML=CONTACTS.map(function(c){var o=document.createElement('option');o.value=c;o.textContent=c;return o.outerHTML}).join('');resetTransfer()}
  function renderBalance(){var u=DB[me];$('bal-num').textContent=u.hidden?'••••••':fmt.format(u.balance);$('tr-avail').textContent=fmt.format(u.balance)}
  function renderTx(){var u=DB[me];$('tx-list').textContent='';if(!u.tx.length){$('tx-list').innerHTML='<div class="tx-empty">No activity yet.</div>';return}u.tx.forEach(function(t){var row=document.createElement('div');row.className='tx-row';var av=document.createElement('div');av.className='tx-av';av.style.background='color-mix(in srgb,'+avColor(t.name)+' 18%,transparent)';av.style.color=avColor(t.name);av.textContent=initials(t.name);var info=document.createElement('div');info.className='tx-info';var name=document.createElement('div');name.className='tx-name';name.textContent=t.name;var meta=document.createElement('div');meta.className='tx-meta';meta.textContent=t.date+(t.note?' · '+t.note:'');info.append(name,meta);var amt=document.createElement('div');amt.className='tx-amt '+(t.dir==='in'?'in':'');amt.textContent=(t.dir==='in'?'+':'−')+fmt.format(Math.abs(t.amount)).slice(1);row.append(av,info,amt);$('tx-list').appendChild(row)})}
  function switchTab(name){$('tab-ov').classList.toggle('active',name==='ov');$('tab-tr').classList.toggle('active',name==='tr');$('pane-ov').style.display=name==='ov'?'':'none';$('pane-tr').style.display=name==='tr'?'':'none';if(name==='tr')resetTransfer()}
  $('tab-ov').addEventListener('click',function(){switchTab('ov')});$('tab-tr').addEventListener('click',function(){switchTab('tr')});
  $('btn-eye').addEventListener('click',function(){DB[me].hidden=!DB[me].hidden;renderBalance()});
  function tErr(msg){if(!msg){$('tr-err').classList.remove('show');return}$('tr-err-msg').textContent=msg;$('tr-err').classList.add('show')}
  function stage(id){$('tr-form').style.display=id==='form'?'':'none';$('tr-confirm').style.display=id==='confirm'?'':'none';$('tr-done').style.display=id==='done'?'':'none'}
  function resetTransfer(){stage('form');tErr('');$('tr-amt').value='';$('tr-note').value=''}
  $('tr-next').addEventListener('click',function(){var u=DB[me],amt=Math.round(parseFloat($('tr-amt').value)*100)/100;if(transfersRestricted){tErr('Transfers are currently restricted by the administrator.');return}if(fundsHeld[me]){tErr('Outgoing transfers are blocked because this account is on hold.');return}if(!isFinite(amt)||amt<=0){tErr('Enter an amount greater than $0.00.');return}if(amt>u.balance){tErr('Insufficient funds — your balance is '+fmt.format(u.balance)+'.');return}pending={to:$('tr-to').value,amount:amt,note:$('tr-note').value.trim()};$('cf-to').textContent=pending.to;$('cf-amt').textContent=fmt.format(amt);if(pending.note){$('cf-note-row').style.display='';$('cf-note').textContent=pending.note}else $('cf-note-row').style.display='none';tErr('');stage('confirm')});
  $('cf-back').addEventListener('click',function(){stage('form')});
  $('cf-send').addEventListener('click',function(){if(!pending)return;var u=DB[me];if(pending.amount>u.balance){tErr('Insufficient funds.');stage('form');pending=null;return}u.balance=Math.round((u.balance-pending.amount)*100)/100;u.tx.unshift({name:pending.to,amount:-pending.amount,dir:'out',date:today(),note:pending.note||undefined});saveState();$('done-msg').textContent=fmt.format(pending.amount)+' sent to '+pending.to;pending=null;renderBalance();renderTx();stage('done')});
  $('done-btn').addEventListener('click',function(){switchTab('ov')});
  function renderAdmin(){
    refreshHistoryUsers($('hist-user').value);
    $('admin-global-status').textContent=transfersRestricted?'Transfers are RESTRICTED for all customer accounts':'Transfers are enabled for all customer accounts';
    $('admin-toggle-transfers').textContent=transfersRestricted?'Release all transfers':'Restrict all transfers';
    $('admin-alex-status').textContent=fundsHeld.alex?'Funds are ON HOLD — outgoing transfers blocked':'Funds available — outgoing transfers allowed';
    $('admin-alex-toggle').textContent=fundsHeld.alex?"Release Alex's funds":"Hold Alex's funds";
    $('admin-sam-status').textContent=fundsHeld.sam?'Funds are ON HOLD — outgoing transfers blocked':'Funds available — outgoing transfers allowed';
    $('admin-sam-toggle').textContent=fundsHeld.sam?"Release Sam's funds":"Hold Sam's funds";
  }
  $('admin-toggle-transfers').addEventListener('click',function(){transfersRestricted=!transfersRestricted;saveState();renderAdmin()});
  $('admin-alex-toggle').addEventListener('click',function(){fundsHeld.alex=!fundsHeld.alex;saveState();renderAdmin()});
  $('admin-sam-toggle').addEventListener('click',function(){fundsHeld.sam=!fundsHeld.sam;saveState();renderAdmin()});
  function localDateString(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
  loadState();refreshHistoryUsers();$('hist-date').value=localDateString();
  $('hist-add').addEventListener('click',function(){var key=$('hist-user').value,desc=$('hist-name').value.trim(),dir=$('hist-dir').value,amt=Math.round(Number($('hist-amt').value)*100)/100,dateValue=$('hist-date').value,note=$('hist-note').value.trim();$('hist-err').classList.remove('show');$('hist-msg').textContent='';if(!desc){$('hist-err-msg').textContent='Enter a transaction description.';$('hist-err').classList.add('show');return}if(!Number.isFinite(amt)||amt<=0){$('hist-err-msg').textContent='Enter an amount greater than $0.00.';$('hist-err').classList.add('show');return}if(!dateValue){$('hist-err-msg').textContent='Choose a transaction date.';$('hist-err').classList.add('show');return}var u=DB[key],signed=dir==='in'?amt:-amt;if(dir==='out'&&amt>u.balance){$('hist-err-msg').textContent='This entry would make the demo balance negative.';$('hist-err').classList.add('show');return}var parts=dateValue.split('-');var shownDate=new Date(Number(parts[0]),Number(parts[1])-1,Number(parts[2])).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});u.balance=Math.round((u.balance+signed)*100)/100;u.tx.unshift({name:desc,amount:signed,dir:dir,date:shownDate,note:note||undefined});saveState();$('hist-name').value='';$('hist-amt').value='';$('hist-note').value='';$('hist-date').value=localDateString();$('hist-msg').textContent='History entry added to '+u.name+' demo account.';if(me===key){renderBalance();renderTx()}renderAdmin()});
  $('admin-logout').addEventListener('click',function(){me=null;pending=null;show('v-login')});
  $('btn-logout').addEventListener('click',function(){me=null;pending=null;show('v-login')});
})();
</script>
</body>
</html>
