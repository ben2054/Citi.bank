
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#071a33">
<title>Northwind Bank</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f2f5fa;color:#17243a}
header{background:#071a33;color:white;padding:22px 16px}
.header-inner{max-width:900px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:12px}
.brand{font-size:22px;font-weight:bold}
.brand span{color:#62b5ff}
main{max-width:900px;margin:22px auto;padding:0 14px 40px}
.card{background:white;padding:20px;border-radius:15px;margin-bottom:16px;box-shadow:0 3px 15px #10233a0d}
h2{margin-top:0;font-size:20px}
input,select,button{width:100%;padding:13px;margin:7px 0;border-radius:9px;font-size:15px}
input,select{border:1px solid #ccd5e2;background:white}
button{border:0;background:#0759b5;color:white;font-weight:bold;cursor:pointer}
button.secondary{background:#e7eef8;color:#12345b}
button.danger{background:#a52828}
.tabs{display:flex;gap:8px;margin-bottom:12px}
.tabs button{flex:1}
.hidden{display:none!important}
.muted{color:#69778a;font-size:13px}
.message{margin:10px 0;padding:10px;border-radius:8px;background:#edf6ff;overflow-wrap:anywhere}
.balance{background:linear-gradient(130deg,#082348,#0759b5);color:white;padding:23px;border-radius:15px}
.balance .amount{font-size:32px;font-weight:bold;margin:12px 0}
.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.stat{background:#f3f6fb;border-radius:10px;padding:13px}
.stat strong{display:block;margin-top:7px;overflow-wrap:anywhere}
.transaction{padding:14px 0;border-bottom:1px solid #e5eaf1;display:flex;justify-content:space-between;gap:12px}
.transaction:last-child{border-bottom:0}
.transaction .desc{font-weight:bold;overflow-wrap:anywhere}
.credit{color:#14804a}.debit{color:#c23b3b}
.small-btn{width:auto;padding:9px 12px}
footer{text-align:center;color:#6d7888;padding:20px;font-size:12px}
@media(min-width:650px){.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}}
</style>
</head>
<body>
<header>
  <div class="header-inner">
    <div class="brand">NORTHWIND <span>BANK</span></div>
    <button id="logoutBtn" class="secondary small-btn hidden" onclick="logout()">Sign out</button>
  </div>
</header>

<main>
  <section id="authSection" class="card">
    <h2 id="authHeading">Welcome back</h2>
    <p class="muted">Sign in or create a local demo account.</p>
    <div class="tabs">
      <button class="secondary" onclick="showAuth('login')">Sign in</button>
      <button class="secondary" onclick="showAuth('register')">Create account</button>
    </div>
    <form id="authForm">
      <div id="nameWrap" class="hidden">
        <label for="fullName">Full name</label>
        <input id="fullName" autocomplete="name" placeholder="Enter your full name">
      </div>
      <label for="email">Email address</label>
      <input id="email" type="email" autocomplete="email" required placeholder="you@example.com">
      <label for="password">Password</label>
      <input id="password" type="password" autocomplete="current-password" required minlength="6" placeholder="At least 6 characters">
      <button id="authSubmit" type="submit">Sign in</button>
    </form>
    <div id="authMessage" class="message hidden"></div>
    <p class="muted">Prototype only. Do not enter a real banking password.</p>
  </section>

  <section id="bankSection" class="hidden">
    <div class="card">
      <h2 id="welcomeName">Welcome</h2>
      <p class="muted" id="customerEmail"></p>
      <div class="balance">
        <div>Displayed demo balance</div>
        <div class="amount" id="balance">₦0.00</div>
        <div class="muted" style="color:#d6e9ff">Simulated account · Not real funds</div>
      </div>
      <div class="stats" style="margin-top:14px">
        <div class="stat"><span class="muted">Account number</span><strong id="accountNumber">—</strong></div>
        <div class="stat"><span class="muted">Transactions</span><strong id="transactionCount">0</strong></div>
      </div>
    </div>

    <div class="card">
      <h2>Transaction history</h2>
      <p class="muted">Transactions entered by the demo administrator appear here.</p>
      <div id="historyList"></div>
    </div>
    <div id="userMessage" class="message hidden"></div>
  </section>

  <section id="adminSection" class="hidden">
    <div class="card">
      <h2>Administrator</h2>
      <p class="muted">Add a simulated transaction to a registered demo account.</p>
      <form id="adminLoginForm">
        <label for="adminPassword">Admin access password</label>
        <input id="adminPassword" type="password" placeholder="Enter admin password" required>
        <button type="submit">Open admin tools</button>
      </form>
      <div id="adminMessage" class="message hidden"></div>
    </div>

    <div id="adminTools" class="card hidden">
      <h2>Enter transaction history</h2>
      <form id="transactionForm">
        <label for="targetEmail">Customer email</label>
        <input id="targetEmail" type="email" required placeholder="customer@example.com">
        <label for="transactionType">Transaction type</label>
        <select id="transactionType">
          <option value="credit">Credit (display only)</option>
          <option value="debit">Debit (display only)</option>
        </select>
        <label for="transactionAmount">Amount (₦)</label>
        <input id="transactionAmount" type="number" min="0.01" step="0.01" required placeholder="0.00">
        <label for="transactionDescription">Description</label>
        <input id="transactionDescription" required maxlength="100" placeholder="e.g. Sample payment">
        <label for="transactionDate">Transaction date</label>
        <input id="transactionDate" type="date" required>
        <button type="submit">Save transaction</button>
      </form>
      <p class="muted">Only use fictional transactions. This page does not process payments.</p>
    </div>

    <div class="card">
      <h2>Registered local demo accounts</h2>
      <div id="accountList"></div>
    </div>
  </section>
</main>

<footer>Northwind Bank · Demonstration website only · No real banking services</footer>

<script>
/*
 DEMO ONLY:
 Data is stored in this browser's localStorage.
 This is not secure authentication or a production banking system.
 Change the demo admin password before testing.
*/
const ADMIN_PASSWORD = "ChangeThisAdmin123!";
const USERS_KEY = "northwind_demo_users_v2";
const SESSION_KEY = "northwind_demo_session_v2";

let authMode = "login";
let currentUserEmail = "";
let adminOpen = false;

function readUsers(){
  try {
    const data = JSON.parse(localStorage.getItem(USERS_KEY) || "{}");
    return data && typeof data === "object" ? data : {};
  } catch(e) {
    return {};
  }
}
function writeUsers(users){
  localStorage.setItem(USERS_KEY, JSON.stringify(users));
}
function normalizeEmail(email){
  return email.trim().toLowerCase();
}
function makeAccountNumber(){
  return String(Math.floor(1000000000 + Math.random() * 9000000000));
}
function money(amount){
  return "₦" + Number(amount || 0).toLocaleString("en-NG", {
    minimumFractionDigits:2, maximumFractionDigits:2
  });
}
function escapeHTML(value){
  return String(value ?? "").replace(/[&<>"']/g, ch => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[ch]));
}
function message(id, text){
  const el = document.getElementById(id);
  el.textContent = text;
  el.classList.remove("hidden");
}
function hideMessage(id){
  document.getElementById(id).classList.add("hidden");
}
function showAuth(mode){
  authMode = mode;
  document.getElementById("authHeading").textContent =
    mode === "login" ? "Welcome back" : "Create your account";
  document.getElementById("nameWrap").classList.toggle("hidden", mode !== "register");
  document.getElementById("fullName").required = mode === "register";
  document.getElementById("password").autocomplete =
    mode === "login" ? "current-password" : "new-password";
  document.getElementById("authSubmit").textContent =
    mode === "login" ? "Sign in" : "Create account";
  hideMessage("authMessage");
}
function setView(view){
  document.getElementById("authSection").classList.toggle("hidden", view !== "auth");
  document.getElementById("bankSection").classList.toggle("hidden", view !== "bank");
  document.getElementById("adminSection").classList.toggle("hidden", view !== "admin");
  document.getElementById("logoutBtn").classList.toggle("hidden", view === "auth");
}
document.getElementById("authForm").addEventListener("submit", function(e){
  e.preventDefault();
  hideMessage("authMessage");
  const email = normalizeEmail(document.getElementById("email").value);
  const password = document.getElementById("password").value;
  const users = readUsers();

  if(authMode === "register"){
    const name = document.getElementById("fullName").value.trim();
    if(!name){
      message("authMessage", "Please enter your name.");
      return;
    }
    if(users[email]){
      message("authMessage", "An account with this email already exists on this browser.");
      return;
    }
    users[email] = {
      name:name,
      email:email,
      password:password,
      accountNumber:makeAccountNumber(),
      transactions:[],
      createdAt:new Date().toISOString()
    };
    writeUsers(users);
    loginUser(email);
    return;
  }

  if(!users[email] || users[email].password !== password){
    message("authMessage", "Incorrect email or password, or no account exists on this browser.");
    return;
  }
  loginUser(email);
});
function loginUser(email){
  currentUserEmail = email;
  localStorage.setItem(SESSION_KEY, email);
  adminOpen = false;
  document.getElementById("adminTools").classList.add("hidden");
  renderBank();
}
function logout(){
  currentUserEmail = "";
  adminOpen = false;
  localStorage.removeItem(SESSION_KEY);
  document.getElementById("authForm").reset();
  document.getElementById("adminTools").classList.add("hidden");
  setView("auth");
  showAuth("login");
}
function calculateBalance(user){
  return (user.transactions || []).reduce((total, tx) => {
    const amount = Number(tx.amount) || 0;
    return total + (tx.type === "credit" ? amount : -amount);
  }, 0);
}
function renderBank(){
  const users = readUsers();
  const user = users[currentUserEmail];
  if(!user){
    logout();
    return;
  }
  document.getElementById("welcomeName").textContent = "Welcome, " + user.name;
  document.getElementById("customerEmail").textContent = user.email;
  document.getElementById("accountNumber").textContent = user.accountNumber;
  document.getElementById("balance").textContent = money(calculateBalance(user));
  const transactions = [...(user.transactions || [])].sort((a,b) =>
    (b.date || "").localeCompare(a.date || "")
  );
  document.getElementById("transactionCount").textContent = transactions.length;
  const list = document.getElementById("historyList");
  if(!transactions.length){
    list.innerHTML = '<p class="muted">No transaction history yet.</p>';
  } else {
    list.innerHTML = transactions.map(tx => {
      const isCredit = tx.type === "credit";
      return `<div class="transaction">
        <div>
          <div class="desc">${escapeHTML(tx.description)}</div>
          <div class="muted">${escapeHTML(tx.date)}</div>
        </div>
        <div class="${isCredit ? "credit" : "debit"}" style="text-align:right;font-weight:bold">
          ${isCredit ? "+" : "−"}${money(tx.amount)}
          <div class="muted">${isCredit ? "Credit" : "Debit"}</div>
        </div>
      </div>`;
    }).join("");
  }
  setView("bank");
}
document.getElementById("adminLoginForm").addEventListener("submit", function(e){
  e.preventDefault();
  const entered = document.getElementById("adminPassword").value;
  if(entered !== ADMIN_PASSWORD){
    message("adminMessage", "Incorrect administrator password.");
    return;
  }
  adminOpen = true;
  document.getElementById("adminTools").classList.remove("hidden");
  document.getElementById("transactionDate").value =
    new Date().toISOString().slice(0,10);
  hideMessage("adminMessage");
  renderAccounts();
});
document.getElementById("transactionForm").addEventListener("submit", function(e){
  e.preventDefault();
  if(!adminOpen){
    message("adminMessage", "Open the administrator tools first.");
    return;
  }
  const email = normalizeEmail(document.getElementById("targetEmail").value);
  const amount = Number(document.getElementById("transactionAmount").value);
  const type = document.getElementById("transactionType").value;
  const description = document.getElementById("transactionDescription").value.trim();
  const date = document.getElementById("transactionDate").value;
  const users = readUsers();

  if(!users[email]){
    message("adminMessage", "No local demo account found for that email.");
    return;
  }
  if(!Number.isFinite(amount) || amount <= 0 || !description || !date){
    message("adminMessage", "Enter a valid amount, description, and date.");
    return;
  }
  users[email].transactions = users[email].transactions || [];
  users[email].transactions.push({
    id:Date.now().toString() + Math.random().toString(16).slice(2),
    type:type,
    amount:Math.round(amount * 100) / 100,
    description:description,
    date:date
  });
  writeUsers(users);
  document.getElementById("transactionForm").reset();
  document.getElementById("transactionDate").value =
    new Date().toISOString().slice(0,10);
  message("adminMessage", "Transaction history saved in this browser.");
  renderAccounts();
  if(currentUserEmail === email) renderBank();
});
function renderAccounts(){
  const users = readUsers();
  const entries = Object.values(users);
  const list = document.getElementById("accountList");
  if(!entries.length){
    list.innerHTML = '<p class="muted">No local accounts created yet.</p>';
    return;
  }
  list.innerHTML = entries.map(user => `
    <div class="transaction">
      <div>
        <div class="desc">${escapeHTML(user.name)}</div>
        <div class="muted">${escapeHTML(user.email)}</div>
        <div class="muted">Account: ${escapeHTML(user.accountNumber)}</div>
      </div>
      <div style="text-align:right">
        <strong>${money(calculateBalance(user))}</strong>
        <div class="muted">${(user.transactions || []).length} records</div>
      </div>
    </div>
  `).join("");
}
function openAdmin(){
  setView("admin");
  document.getElementById("adminLoginForm").reset();
  document.getElementById("adminTools").classList.add("hidden");
  hideMessage("adminMessage");
  renderAccounts();
}
function renderAdminShortcut(){
  const section = document.getElementById("adminSection");
  if(document.getElementById("adminShortcut")) return;
  const btn = document.createElement("button");
  btn.id = "adminShortcut";
  btn.className = "secondary";
  btn.textContent = "Administrator tools";
  btn.onclick = openAdmin;
  section.insertBefore(btn, section.firstChild);
}
renderAdminShortcut();

const savedSession = localStorage.getItem(SESSION_KEY);
if(savedSession && readUsers()[savedSession]){
  loginUser(savedSession);
} else {
  setView("auth");
  showAuth("login");
}
</script>
</body>
</html>
